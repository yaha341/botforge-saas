JWT_SECRET=your_cookie_secret_min_32_chars

# ─── Supabase (PostgreSQL) ───────────────────────────────────────────
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:your_supabase_password@db.fnwksbasxakktscdjlfp.supabase.co:5432/postgres

# ─── Prodamus (Payments) ────────────────────────────────────────────
PRODAMUS_SHOP_URL=https://www.prodamus.com/buy
PRODAMUS_SECRET_KEY=your_prodamus_secret_key

# ─── Zernio (Instagram Automation) ──────────────────────────────────
ZERNIO_API_KEY=sk_56e035fc200bc47530f01ad7c264fb04a94ab7ab4c3c3faff292f8371a98adbf

# ─── Public URL ──────────────────────────────────────────────────────
